{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "ClientBaseUrl": "https://app.propeliq.com"
  },
  "ConnectionStrings": {
    "Default": "",
    "AppApi": "",
    "AppAnalytics": "",
    "AppAdmin": ""
  },
  "Jwt": {
    "Issuer": "propeliq-api",
    "Audience": "propeliq-clients",
    "SigningKey": "REPLACE_WITH_VAULT_MANAGED_KEY_MIN_256_BITS_AAAAAAAAAA",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "HealthChecks": {
    "EvaluationTimeInSeconds": 10,
    "IndividualCbTimeout": 5
  },
  "OpenTelemetry": {
    "ServiceName": "propeliq-api",
    "OtlpEndpoint": ""
  },
  "CacheSettings": {
    "DefaultTtlSeconds": 300,
    "SlotSearchTtlSeconds": 120,
    "ProfileReadTtlSeconds": 600,
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "BreakDurationSeconds": 60,
      "SamplingWindowSeconds": 30
    }
  },
  "AiGateway": {
    "BaseUrl": "http://localhost:4000",
    "ApiKey": "",
    "DefaultModel": "coding-suggestion",
    "MaxRetries": 3,
    "TimeoutSeconds": 10,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerDurationSeconds": 30
  },
  "Ics": {
    "ProductId": "-//PropelIQ//Appointment Scheduler//EN",
    "DefaultTimezone": "UTC",
    "OrganizerEmail": "noreply@propeliq.com"
  },
  "Queue": {
    "CacheTtlSeconds": 15
  },
  "WaitTime": {
    "DefaultServiceDurationMinutes": 15,
    "AppointmentTypeDurations": {
      "GENERAL": 20,
      "FOLLOWUP": 10,
      "URGENT": 30,
      "NEW_PATIENT": 30,
      "ANNUAL": 25
    }
  },
  "WalkIn": {
    "CapacityThreshold": 50
  },
  "ClamAv": {
    "Host": "clamav",
    "Port": 3310,
    "TimeoutSeconds": 30
  },
  "Ocr": {
    "MaxRetries": 3,
    "ConcurrencyLimit": 4,
    "ConfidenceThreshold": 0.60,
    "TessdataPath": "./tessdata",
    "BackoffBaseSeconds": 1
  },
  "Extraction": {
    "ConfidenceThreshold": 0.70,
    "MaxChunkSize": 4000,
    "ConcurrencyLimit": 2,
    "MaxRetries": 3,
    "LowQualityTextLengthThreshold": 50,
    "BackoffBaseSeconds": 1,
    "ExtractionModelId": "gpt-4.1",
    "MaxTokens": 4096
  }
}

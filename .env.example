# PropelIQ — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (.gitignore excludes it).
#
# Usage:
#   cp .env.example .env
#   # edit .env with your local credentials
#   docker compose up -d

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Database name created on first container start.
POSTGRES_DB=propeliq

# Application database user (least-privilege account for the API).
POSTGRES_USER=propeliq_user

# Database password — use a strong random value in shared/staging environments.
POSTGRES_PASSWORD=propeliq_dev_pass

# Host port mapping. Change if 5432 is already in use on your machine.
# docker-compose.yml maps this to container port 5432.
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis host — use 'localhost' when connecting from the host machine.
REDIS_HOST=localhost

# Redis port mapping. Change if 6379 is already in use on your machine.
REDIS_PORT=6379

# Redis password — must match --requirepass in docker-compose.yml.
# Use a strong random value in shared/staging environments.
REDIS_PASSWORD=propeliq_dev_pass

# ── API ───────────────────────────────────────────────────────────────────────
# Host port for the ASP.NET Core API container. Change if 5000 is already in use.
API_PORT=5000

# ── Angular ───────────────────────────────────────────────────────────────────
# Host port for the Angular dev server container. Change if 4200 is already in use.
ANGULAR_PORT=4200

# ── Observability ─────────────────────────────────────────────────────────────
# Grafana admin password. Defaults to 'admin' in docker-compose.yml when not set.
# Use a strong random value in shared/staging environments.
GRAFANA_ADMIN_PASSWORD=admin

# ── AI Gateway (LiteLLM) ──────────────────────────────────────────────────────
# Azure OpenAI resource API key.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Azure OpenAI resource endpoint URL (include trailing slash).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# LiteLLM master key — all API requests to the gateway must include
# "Authorization: Bearer <value>". Use a strong random value.
LITELLM_MASTER_KEY=sk-propeliq-gateway-key
